              "privacy": "private",
              "readonly": true,
              "default": "new SnapshotActions({ msg: this.msg, service: this.snapshotService, canvasHost: this.canvasHost, getRoot: () => this.shadowRoot, run: this.run, chartRuntime: this.chartRuntime, getConfig: () => this.config, getHotspots: () => this.hotspotEditing.userHotspots, onChanged: () => { this.stateSync.flush() this.requestUpdate() }, })"
            },
            {
              "kind": "field",
              "name": "hotspotEditing",
              "type": {
                "text": "HotspotEditingController"
              },
              "privacy": "private",
              "readonly": true,
              "default": "new HotspotEditingController({ getCanvas: () => this.simulationCanvas, getConfig: () => this.config, enableHotspots: () => { this.hotspotsEnabled = true }, onHotspotsChanged: () => { this.stateSync.schedule() this.requestUpdateAndRedrawSimulationWhenPaused() }, onRestartPreservingHotspots: () => { this.stateSync.schedule() this.restartSimulation() }, isPointerDragging: (hotspotId: number): boolean => this.hotspotPointer.isDragging(hotspotId), clearPointer: () => this.hotspotPointer.clear(), persistHotspots: () => { this.stateSync.schedule() }, })"
            },
