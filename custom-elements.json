      "declarations": [
        {
          "kind": "class",
          "description": "Agent-based epidemic simulation with a live chart, a simulation map and optional interventions.\n\nPeople are dots on a map; an infected dot within the infection radius of a susceptible one may infect it.\nThe model (SIR, SIRS, SEIR, SIRD, SEIRD) decides which states exist. Learners can switch on quarantine,\nhotspots (places where people gather) and communities, save snapshots of the curves and read key figures\nsuch as R0 in the insights panel. Authors set the parameters in the options panel; each has an\n`allow-...-control` attribute that shows it in the learners' sidebar.\n\nThe simulation runs 24 frames per day. Durations are stored in frames and shown in days (120 frames are 5 days).\nSettings are attributes. Hotspots and snapshots are JSON in a direct data block (`<script slot=\"data\">`);\nsnapshots hold only the curve data, so documents stay small.",
          "name": "WebwriterEpidemicSim",
          "members": [
            {
              "kind": "field",
              "name": "scopedElements",
              "type": {
                "text": "object"
              },
              "static": true,
              "default": "{ \"sl-button\": SlButton, \"sl-card\": SlCard, \"sl-details\": SlDetails, \"sl-dropdown\": SlDropdown, \"sl-icon\": SlIcon, \"sl-menu\": SlMenu, \"sl-menu-item\": SlMenuItem, \"sl-range\": SlRange, \"sl-switch\": SlSwitch, \"sl-tag\": SlTag, \"sl-select\": SlSelect, \"sl-option\": SlOption, }"
            },
            {
              "kind": "field",
              "name": "optionGroups",
              "type": {
                "text": "object"
              },
              "static": true,
              "default": "{ model: {label: (widget: {msg: MsgFn}) => widget.msg(\"Model\"), collapsible: true}, general: {label: (widget: {msg: MsgFn}) => widget.msg(\"General\"), collapsible: true}, quarantine: {label: (widget: {msg: MsgFn}) => widget.msg(\"Quarantine\"), advanced: true}, hotspots: {label: (widget: {msg: MsgFn}) => widget.msg(\"Hotspots\"), advanced: true}, communities: {label: (widget: {msg: MsgFn}) => widget.msg(\"Communities\"), advanced: true}, controls: {label: (widget: {msg: MsgFn}) => widget.msg(\"Learner controls\"), advanced: true}, }"
