              },
              "privacy": "private",
              "readonly": true,
              "default": "new HotspotPointerController(this, { getCanvas: () => this.simulationCanvas, getAreas: (): SimulationAreas => this.hotspotEditing.getAreas(this.config), updateHotspotRect: (hotspotId: number, rect) => this.hotspotEditing.updateHotspotRect(hotspotId, rect), removeHotspot: (hotspotId: number) => this.hotspotEditing.removeHotspot(hotspotId), onRemovalPendingChange: () => this.requestUpdateAndRedrawSimulationWhenPaused(), })"
            },
